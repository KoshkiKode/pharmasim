{
  "name": "pharmasim-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run start -w apps/mobile",
    "build": "npm run build -w packages/engine",
    "typecheck": "npm run build && npm run typecheck -w packages/engine -w apps/mobile -w apps/linux-desktop",
    "test": "npm run build && npm test -w packages/engine -w apps/linux-desktop",
    "desktop:linux": "npm run tauri:build -w apps/linux-desktop",
    "mobile": "npm run start -w apps/mobile",
    "bench": "npm run bench -w packages/engine",
    "test:stress": "npm run test:stress -w packages/engine"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "@types/react": "~19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-gesture-handler": "^3.4.0"
  },
  "overrides": {
    "@types/react": "~19.3.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-clean": "20.2.0",
    "@react-native-community/cli-config": "20.2.0",
    "@react-native-community/cli-config-android": "20.2.0",
    "@react-native-community/cli-config-apple": "20.2.0",
    "@react-native-community/cli-doctor": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-apple": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-community/cli-server-api": "20.2.0",
    "@react-native-community/cli-tools": "20.2.0",
    "@react-native-community/cli-types": "20.2.0",
    "fast-xml-parser": "^5.11.2"
  }
}
